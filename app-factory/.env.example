# App Store Connect API (Users and Access → Integrations → App Store Connect API)
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=./secrets/AuthKey_XXXXXXXXXX.p8   # keep outside git; secrets/ is gitignored
APPLE_TEAM_ID=
APPLE_ID=
BUNDLE_ID_PREFIX=com.yourcompany           # each app appends its slug
PRIVACY_POLICY_BASE_URL=https://yourname.github.io/legal   # per-app: <base>/<slug>/privacy
# Optional external research model (Kimi etc.) — consumed by scripts/scout/trends.py --llm
RESEARCH_LLM_ENDPOINT=
RESEARCH_LLM_KEY=
